# sovereign-agent Docker environment — copy to .env and customize
# cp .env.example .env

# Ollama host (where the LLM runs)
# On Mac/Windows Docker Desktop: http://host.docker.internal:11434
# On Linux with host network:    http://localhost:11434
OLLAMA_HOST=http://host-gateway:11434

# Which model Aria uses
SOV_MODEL=qwen3:8b

# Log level (DEBUG, INFO, WARNING, ERROR)
SOV_LOG_LEVEL=WARNING

# MCP server port (for Claude Desktop connection)
MCP_PORT=8765
